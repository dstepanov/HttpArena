+++ b/http-server-netty/src/test/java/io/micronaut/http/server/netty/Http2ConnectionErrorsTest.java
@@ -0,0 +1,119 @@
+package io.micronaut.http.server.netty;
+
+import ch.qos.logback.classic.Level;
+import ch.qos.logback.classic.Logger;
+import ch.qos.logback.classic.spi.ILoggingEvent;
+import ch.qos.logback.core.read.ListAppender;
+import io.micronaut.context.ApplicationContext;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.MediaType;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.http.client.HttpClient;
+import io.micronaut.runtime.server.EmbeddedServer;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import io.netty.handler.codec.http2.Http2ConnectionHandler;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class Http2ConnectionErrorsTest {
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void tlsConnectionErrorsReachCustomizersAndTheServerErrorPolicy(boolean legacy) throws Exception {
+        Logger routingLogger = (Logger) LoggerFactory.getLogger(RoutingInBoundHandler.class);
+        Logger tailLogger = (Logger) LoggerFactory.getLogger("io.netty.channel.DefaultChannelPipeline");
+        var previousLevel = routingLogger.getLevel();
+        ListAppender<ILoggingEvent> routingLogs = new ListAppender<>();
+        ListAppender<ILoggingEvent> tailLogs = new ListAppender<>();
+        routingLogs.start();
+        tailLogs.start();
+        routingLogger.addAppender(routingLogs);
+        tailLogger.addAppender(tailLogs);
+        routingLogger.setLevel(Level.DEBUG);
+        try (ApplicationContext context = ApplicationContext.run(Map.of(
+            "spec.name", "Http2ConnectionErrorsTest",
+            "micronaut.server.http-version", "2.0",
+            "micronaut.server.port", -1,
+            "micronaut.server.ssl.enabled", true,
+            "micronaut.server.ssl.port", -1,
+            "micronaut.server.ssl.build-self-signed", true,
+            "micronaut.server.netty.legacy-multiplex-handlers", legacy,
+            "micronaut.http.client.http-version", "2.0",
+            "micronaut.http.client.ssl.insecure-trust-all-certificates", true
+        ))) {
+            List<Channel> connections = new CopyOnWriteArrayList<>();
+            List<Throwable> observed = new CopyOnWriteArrayList<>();
+            context.getBean(NettyServerCustomizer.Registry.class).register(new NettyServerCustomizer() {
+                @Override
+                public NettyServerCustomizer specializeForChannel(Channel channel, ChannelRole role) {
+                    if (role != ChannelRole.CONNECTION) {
+                        return this;
+                    }
+                    return new NettyServerCustomizer() {
+                        @Override
+                        public void onInitialPipelineBuilt() {
+                            if (channel.pipeline().get(Http2ConnectionHandler.class) != null) {
+                                connections.add(channel);
+                                channel.pipeline().addLast("custom-error-observer", new ChannelInboundHandlerAdapter() {
+                                    @Override
+                                    public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) {
+                                        observed.add(cause);
+                                        ctx.fireExceptionCaught(cause);
+                                    }
+                                });
+                            }
+                        }
+                    };
+                }
+            });
+            EmbeddedServer server = context.getBean(EmbeddedServer.class).start();
+            try (HttpClient client = context.createBean(HttpClient.class, server.getURL())) {
+                assertEquals("ok", client.toBlocking().retrieve("/connection-errors"));
+                assertEquals(1, connections.size());
+                Channel channel = connections.getFirst();
+                List<Throwable> failures = List.of(
+                    new IOException("io_uring write(..) failed with error(-32): Broken pipe"),
+                    new IOException("real transport failure"),
+                    new IllegalStateException("Broken pipe")
+                );
+                for (Throwable failure : failures) {
+                    channel.eventLoop().submit(() -> channel.pipeline().fireExceptionCaught(failure)).get(10, TimeUnit.SECONDS);
+                    List<ILoggingEvent> events = routingLogs.list.stream()
+                        .filter(event -> event.getThrowableProxy() != null && failure.getMessage().equals(event.getThrowableProxy().getMessage()))
+                        .toList();
+                    assertEquals(1, events.size());
+                    assertEquals(failure == failures.getFirst() ? Level.DEBUG : Level.ERROR, events.getFirst().getLevel());
+                }
+                assertEquals(failures, observed);
+                assertTrue(tailLogs.list.isEmpty());
+            }
+        } finally {
+            routingLogger.detachAppender(routingLogs);
+            tailLogger.detachAppender(tailLogs);
+            routingLogger.setLevel(previousLevel);
+            routingLogs.stop();
+            tailLogs.stop();
+        }
+    }
+
+    @Controller("/connection-errors")
+    @Requires(property = "spec.name", value = "Http2ConnectionErrorsTest")
+    static class TestController {
+        @Get(produces = MediaType.TEXT_PLAIN)
+        String get() {
+            return "ok";
+        }
+    }
+}
