+package io.micronaut.http.server.netty.handler
+
+import io.micronaut.http.body.CloseableByteBody
+import io.micronaut.http.netty.body.NettyByteBodyFactory
+import io.micronaut.http.server.netty.EmbeddedTestUtil
+import io.netty.buffer.ByteBuf
+import io.netty.buffer.Unpooled
+import io.netty.channel.ChannelHandlerContext
+import io.netty.channel.ChannelOutboundHandlerAdapter
+import io.netty.channel.ChannelPromise
+import io.netty.channel.embedded.EmbeddedChannel
+import io.netty.handler.codec.http.DefaultHttpResponse
+import io.netty.handler.codec.http.HttpRequest
+import io.netty.handler.codec.http.HttpResponseStatus
+import io.netty.handler.codec.http.HttpVersion
+import io.netty.handler.codec.http2.DefaultHttp2Headers
+import io.netty.handler.codec.http2.DefaultHttp2HeadersFrame
+import io.netty.handler.codec.http2.Http2ChannelDuplexHandler
+import io.netty.handler.codec.http2.Http2FrameCodecBuilder
+import jdk.jfr.Recording
+import jdk.jfr.consumer.RecordingFile
+import spock.lang.Specification
+
+import java.nio.channels.ClosedChannelException
+import java.nio.file.Files
+
+class Http2WriteFailureSpec extends Specification {
+    private static class Client extends Http2ChannelDuplexHandler {
+    }
+
+    def "writes failed after the connection pipeline is removed still report real errors"() {
+        given:
+        def recording = new Recording()
+        if (jfr) {
+            recording.enable(Http2RequestEvent)
+            recording.start()
+        }
+        def eventsFile = Files.createTempFile("http2-write-failure", ".jfr")
+        def server = new EmbeddedChannel()
+        def client = new EmbeddedChannel()
+        EmbeddedTestUtil.connect(server, client)
+        OutboundAccess access = null
+        int responsesWritten = 0
+        boolean record = recordFinalWrite
+        server.pipeline().addLast("http2", new Http2ServerHandler.ConnectionHandlerBuilder(new RequestHandler() {
+            @Override
+            void accept(ChannelHandlerContext ctx, HttpRequest request, CloseableByteBody body, OutboundAccess outboundAccess) {
+                body.close()
+                access = outboundAccess
+                if (record) {
+                    assert outboundAccess.recordFinalWrite()
+                }
+            }
+
+            @Override
+            void responseWritten(Object attachment) {
+                responsesWritten++
+            }
+
+            @Override
+            void handleUnboundError(Throwable cause) {
+                throw new AssertionError(cause)
+            }
+        }).build())
+        def duplex = new Client()
+        client.pipeline().addLast(Http2FrameCodecBuilder.forClient().build(), duplex)
+        def headers = new DefaultHttp2Headers().method("GET").scheme("http").authority("example.com").path("/pending")
+        client.writeOutbound(new DefaultHttp2HeadersFrame(headers, true).stream(duplex.newStream()))
+        EmbeddedTestUtil.advance(server, client)
+
+        List<ByteBuf> pending = []
+        List<ChannelPromise> promises = []
+        def capture = new ChannelOutboundHandlerAdapter() {
+            boolean armed = true
+
+            @Override
+            void write(ChannelHandlerContext ctx, Object msg, ChannelPromise promise) {
+                if (armed) {
+                    pending.add((ByteBuf) msg)
+                    promises.add(promise)
+                } else {
+                    ctx.write(msg, promise)
+                }
+            }
+        }
+        server.pipeline().addBefore("http2", "pending-writes", capture)
+        def content = Unpooled.buffer(16).writeZero(bodySize)
+
+        when: "the transport closes before the already submitted writes finish"
+        access.write(new DefaultHttpResponse(HttpVersion.HTTP_1_1, HttpResponseStatus.OK), new NettyByteBodyFactory(server).adapt(content))
+        server.runPendingTasks()
+        assert !pending.isEmpty()
+        capture.armed = false
+        server.pipeline().get("http2").gracefulShutdownTimeoutMillis(0)
+        server.close()
+        EmbeddedTestUtil.advance(server, client)
+        assert server.pipeline().context("http2") == null
+        pending.each { it.release() }
+        promises.each { it.tryFailure(failure) }
+        server.runPendingTasks()
+        Throwable observedFailure = null
+        try {
+            server.checkException()
+        } catch (Throwable t) {
+            observedFailure = t
+        }
+
+        then:
+        responsesWritten == 1
+        content.refCnt() == 0
+        !recordFinalWrite || access.finalWrite().cause().is(failure)
+        failure instanceof ClosedChannelException ? observedFailure == null : observedFailure.is(failure)
+
+        when:
+        if (jfr) {
+            recording.stop()
+            recording.dump(eventsFile)
+        }
+
+        then: "the final write still completes the request event"
+        !jfr || RecordingFile.readAllEvents(eventsFile).findAll { it.eventType.name == Http2RequestEvent.name && it.getString("uri") == "/pending" }.size() == 1
+
+        cleanup:
+        recording.close()
+        Files.deleteIfExists(eventsFile)
+        pending.each { if (it.refCnt() > 0) it.release() }
+        client.finishAndReleaseAll()
+        server.finishAndReleaseAll()
+
+        where:
+        jfr   | recordFinalWrite | bodySize | failure
+        false | false            | 16       | new ClosedChannelException()
+        false | true             | 16       | new ClosedChannelException()
+        true  | false            | 16       | new ClosedChannelException()
+        true  | true             | 16       | new ClosedChannelException()
+        false | false            | 0        | new ClosedChannelException()
+        true  | false            | 0        | new ClosedChannelException()
+        false | false            | 16       | new IOException("real transport failure")
+        true  | false            | 16       | new IOException("real transport failure")
+    }
+}
