+package io.micronaut.http.server.body
+
+import io.micronaut.core.io.buffer.ByteArrayBufferFactory
+import io.micronaut.core.io.buffer.ReadBuffer
+import io.micronaut.core.io.buffer.ReadBufferFactory
+import io.micronaut.http.HttpRequest
+import io.micronaut.http.HttpResponse
+import io.micronaut.http.body.ByteBodyFactory
+import io.micronaut.http.server.HttpServerConfiguration
+import io.micronaut.http.server.types.files.SystemFile
+import reactor.core.publisher.Flux
+import spock.lang.Specification
+
+import java.nio.channels.ScatteringByteChannel
+import java.nio.file.Files
+import java.util.concurrent.Executors
+
+class SystemFileBodyWriterSpec extends Specification {
+    def "file and range buffers are read on the IO executor through a channel"() {
+        given:
+        def file = Files.createTempFile("system-file-writer", ".bin")
+        byte[] bytes = new byte[20003]
+        new Random(1).nextBytes(bytes)
+        Files.write(file, bytes)
+        def executor = Executors.newSingleThreadExecutor()
+        def caller = Thread.currentThread()
+        ScatteringByteChannel usedChannel = null
+        def factory = new ReadBufferFactory() {
+            @Override
+            ReadBuffer copyOf(ScatteringByteChannel channel, int n) {
+                assert Thread.currentThread() != caller
+                usedChannel = channel
+                return super.copyOf(channel, n)
+            }
+        }
+        def bodyFactory = new ByteBodyFactory(ByteArrayBufferFactory.INSTANCE, factory) {}
+        def writer = new SystemFileBodyWriter(new HttpServerConfiguration.FileTypeHandlerConfiguration(), executor)
+        def request = HttpRequest.GET("/file")
+        if (range != null) {
+            request.header("Range", range)
+        }
+        def systemFile = new SystemFile(file.toFile())
+
+        when:
+        def response = writer.write(bodyFactory, request, HttpResponse.ok(systemFile), systemFile)
+        def output = new ByteArrayOutputStream()
+        Flux.from(response.byteBody().toReadBufferPublisher()).doOnNext { it.transferTo(output) }.blockLast()
+
+        then:
+        response.code() == status
+        output.toByteArray() == Arrays.copyOfRange(bytes, start, end)
+        usedChannel != null
+        !usedChannel.open
+
+        cleanup:
+        executor.shutdown()
+        Files.deleteIfExists(file)
+
+        where:
+        range               | status | start | end
+        null                | 200    | 0     | 20003
+        "bytes=0-0"         | 206    | 0     | 1
+        "bytes=7777-17001"  | 206    | 7777  | 17002
+        "bytes=16384-"      | 206    | 16384 | 20003
+        "bytes=-9000"       | 206    | 11003 | 20003
+    }
+
+    def "file reads see a truncation after the response headers were prepared"() {
+        given:
+        def file = Files.createTempFile("system-file-writer", ".bin")
+        Files.write(file, new byte[10000])
+        def executor = Executors.newSingleThreadExecutor()
+        def writer = new SystemFileBodyWriter(new HttpServerConfiguration.FileTypeHandlerConfiguration(), executor)
+        def bodyFactory = ByteBodyFactory.createDefault(ByteArrayBufferFactory.INSTANCE)
+        def systemFile = new SystemFile(file.toFile())
+        def response = writer.write(bodyFactory, HttpRequest.GET("/file"), HttpResponse.ok(systemFile), systemFile)
+        Files.write(file, [1, 2, 3] as byte[])
+
+        when:
+        def output = new ByteArrayOutputStream()
+        Flux.from(response.byteBody().toReadBufferPublisher()).doOnNext { it.transferTo(output) }.blockLast()
+
+        then:
+        response.byteBody().expectedLength().asLong == 10000
+        output.toByteArray() == [1, 2, 3] as byte[]
+
+        cleanup:
+        executor.shutdown()
+        Files.deleteIfExists(file)
+    }
+}
