+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class NettyHttpParametersTest {
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void decodingAndMutationPreserveOrderAndImmutableViews(boolean owned) {
+        NettyHttpParameters parameters = parameters("/p?b=2&a=1&a=3&escaped=x%2By%26z&space=x+y", owned, null);
+        assertEquals(List.of("b", "a", "escaped", "space"), new ArrayList<>(parameters.names()));
+        assertEquals(List.of("1", "3"), parameters.getAll("a"));
+        assertEquals("x+y&z", parameters.get("escaped"));
+        assertEquals("x y", parameters.get("space"));
+        Collection<List<String>> values = parameters.values();
+        List<String> original = parameters.getAll("a");
+        assertThrows(UnsupportedOperationException.class, values::clear);
+        assertThrows(UnsupportedOperationException.class, () -> values.iterator().next().add("bad"));
+        assertThrows(UnsupportedOperationException.class, () -> original.add("bad"));
+
+        parameters.add("a", List.of("4"));
+        CharSequence name = CharBuffer.wrap("added");
+        parameters.add(name, List.of("5"));
+        assertEquals(List.of("1", "3"), original);
+        assertEquals(List.of("1", "3", "4"), parameters.getAll("a"));
+        assertEquals(List.of("5"), parameters.getAll(name));
+        assertEquals(List.of("b", "a", "escaped", "space", "added"), new ArrayList<>(parameters.names()));
+        assertEquals(List.of(List.of("2"), List.of("1", "3", "4"), List.of("x+y&z"), List.of("x y"), List.of("5")), new ArrayList<>(values));
+        assertThrows(UnsupportedOperationException.class, () -> parameters.getAll("a").clear());
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void emptyParametersCanBeAddedAndNotifyChanges(boolean owned) {
+        List<List<String>> changes = new ArrayList<>();
+        CharSequence name = CharBuffer.wrap("a");
+        NettyHttpParameters parameters = parameters("/p", owned, (key, value) -> {
+            assertSame(name, key);
+            changes.add(value);
+        });
+        assertTrue(parameters.names().isEmpty());
+        parameters.add(name, List.of("1"));
+        parameters.add(name, List.of("2"));
+        assertEquals(List.of(List.of("1"), List.of("1", "2")), changes);
+        assertEquals(List.of("1", "2"), parameters.getAll(name));
+        assertThrows(UnsupportedOperationException.class, () -> changes.getFirst().add("bad"));
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void conversionServiceCanBeReplaced(boolean owned) {
+        NettyHttpParameters parameters = parameters("/p?a=42", owned, null);
+        DefaultMutableConversionService service = new DefaultMutableConversionService();
+        parameters.setConversionService(service);
+        assertSame(service, parameters.getConversionService());
+        assertEquals(42, parameters.get("a", Integer.class).orElseThrow());
+    }
+
+    @Test
+    void existingConstructorSnapshotsMapButKeepsListContentsAliased() {
+        List<String> sourceValues = new ArrayList<>(List.of("1"));
+        Map<String, List<String>> source = new LinkedHashMap<>();
+        source.put("a", sourceValues);
+        NettyHttpParameters parameters = new NettyHttpParameters(source, ConversionService.SHARED, null);
+        source.clear();
+        source.put("b", List.of("3"));
+        sourceValues.add("2");
+        assertEquals(List.of("a"), new ArrayList<>(parameters.names()));
+        assertEquals(List.of("1", "2"), parameters.getAll("a"));
+
+        parameters.add("a", List.of("4"));
+        assertEquals(List.of("1", "2"), sourceValues);
+        assertEquals(List.of("1", "2", "4"), parameters.getAll("a"));
+    }
+
+    private static NettyHttpParameters parameters(String uri, boolean owned, BiConsumer<CharSequence, List<String>> onChange) {
+        QueryStringDecoder decoder = new QueryStringDecoder(uri);
+        return owned ? NettyHttpParameters.fromDecoder(decoder, ConversionService.SHARED, onChange) :
+            new NettyHttpParameters(decoder.parameters(), ConversionService.SHARED, onChange);
+    }
+}
