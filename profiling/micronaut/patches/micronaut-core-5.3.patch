+        try (ReadBuffer buffer = factory.adapt(allocator.buffer(bytes.length).writeBytes(bytes))) {
+            blackhole.consume(buffer);
+        }
+    }
+
+    @Benchmark
+    public void jdkEncoder(Blackhole blackhole) {
+        try (ReadBuffer buffer = factory.adapt(ByteBufUtil.encodeString(allocator, CharBuffer.wrap(text), StandardCharsets.UTF_8))) {
+            blackhole.consume(buffer);
+        }
+    }
+}
