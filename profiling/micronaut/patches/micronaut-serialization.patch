@@ -28,6 +28,7 @@ import io.micronaut.serde.config.annotation.SerdeConfig;
 import io.micronaut.serde.exceptions.SerdeException;
 import io.micronaut.serde.reference.PropertyReference;
 import io.micronaut.serde.reference.SerializationReference;
+import io.micronaut.serde.support.util.DecoderValueKind;
 
 import java.io.IOException;
 import java.util.List;
@@ -52,10 +53,34 @@ import java.util.Objects;
 final class CustomizedObjectSerializer<T> implements ObjectSerializer<T> {
     private final SerBean<T> serBean;
     private final Keys keys;
+    private final byte[] primitiveValueKinds;
 
     CustomizedObjectSerializer(SerBean<T> serBean) {
         this.serBean = serBean;
         this.keys = serBean.propertyKeys;
+        this.primitiveValueKinds = new byte[serBean.writeProperties.size()];
+        // Keep primitive access direct when another property requires customization.
+        if (serBean.propertyFilter == null) {
+            for (int i = 0; i < primitiveValueKinds.length; i++) {
+                SerBean.SerProperty<T, Object> property = serBean.writeProperties.get(i);
+                if (property.primitive
+                    && property instanceof SerBean.PropSerProperty<?, ?>
+                    && !property.serializableInto
+                    && property.include == SerdeConfig.SerInclude.ALWAYS
+                    && property.views == null
+                    && property.backRef == null
+                    && property.managedRef == null
+                    && property.format == null
+                    && property.featuresWith.isEmpty()
+                    && property.featuresWithout.isEmpty()
+                    && property.serializer instanceof DecoderValueKind.Provider provider) {
+                    byte kind = provider.decoderValueKind().code();
+                    if (kind >= DecoderValueKind.BOOLEAN_CODE && kind <= DecoderValueKind.CHAR_CODE) {
+                        primitiveValueKinds[i] = kind;
+                    }
+                }
+            }
+        }
     }
 
     @Override
@@ -72,6 +97,12 @@ final class CustomizedObjectSerializer<T> implements ObjectSerializer<T> {
         for (SerBean.SerProperty<T, Object> property : serBean.writeProperties) {
             int keyIndex = propertyIndex++;
             try {
+                byte primitiveValueKind = primitiveValueKinds[keyIndex];
+                if (primitiveValueKind != DecoderValueKind.NONE_CODE) {
+                    keysAwareEncoder.encodeKey(keys, keyIndex);
+                    property.serializeDirectPrimitive(keysAwareEncoder, value, primitiveValueKind);
+                    continue;
+                }
                 final Object propertyValue = property.get(value);
                 final Serializer<Object> serializer = Objects.requireNonNull(property.serializer);
                 final String backRef = property.backRef;
