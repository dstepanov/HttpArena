+ */
+package io.micronaut.serde.jackson.annotation
+
+import io.micronaut.serde.exceptions.SerdeException
+import io.micronaut.serde.jackson.JsonCompileSpec
+
+class UnwrappedPrimitiveSpec extends JsonCompileSpec {
+
+    void 'unwrapped beans serialize primitive siblings without changing their scalar kinds'() {
+        given:
+        def context = buildContext('example.Parent', '''
+package example;
+
+import com.fasterxml.jackson.annotation.*;
+import io.micronaut.serde.annotation.Serdeable;
+
+@Serdeable
+@JsonInclude(JsonInclude.Include.ALWAYS)
+record Parent(boolean a, byte b, short c, char d, int e, long f, float g, double h,
+              @JsonUnwrapped Name name) {}
+@Serdeable
+record Name(String value) {}
+''')
+        def name = newInstance(context, 'example.Name', 'nested')
+        def parent = newInstance(context, 'example.Parent', true, (byte) 2, (short) 300, (char) 'x',
+            1000, 100000L, 1.25f, 2.5d, name)
+
+        expect:
+        serializeToString(jsonMapper, parent) ==
+            '{"a":true,"b":2,"c":300,"d":120,"e":1000,"f":100000,"g":1.25,"h":2.5,"value":"nested"}'
+
+        cleanup:
+        context.close()
+    }
+
+    void 'unwrapped properties retain position, prefix, null handling and formatted primitive siblings'() {
+        given:
+        def context = buildContext('example.Parent', '''
+package example;
+
+import com.fasterxml.jackson.annotation.*;
+import io.micronaut.serde.annotation.Serdeable;
+
+@Serdeable
+@JsonInclude(JsonInclude.Include.ALWAYS)
+record Parent(long first, @JsonUnwrapped(prefix = "n_", suffix = "_x") Name name,
+              @JsonFormat(shape = JsonFormat.Shape.STRING) long last) {}
+@Serdeable
+record Name(String value, int count) {}
+''')
+        def name = newInstance(context, 'example.Name', 'Snow ☃', 300)
+
+        expect:
+        serializeToString(jsonMapper, newInstance(context, 'example.Parent', 1000L, name, 2000L)) ==
+            '{"first":1000,"n_value_x":"Snow ☃","n_count_x":300,"last":"2000"}'
+        serializeToString(jsonMapper, newInstance(context, 'example.Parent', 1000L, null, 2000L)) ==
+            '{"first":1000,"last":"2000"}'
+
+        cleanup:
+        context.close()
+    }
+
+    void 'unwrapped primitive siblings retain inclusion and views'() {
+        given:
+        def context = buildContext('example.Parent', '''
+package example;
+
+import com.fasterxml.jackson.annotation.*;
+import io.micronaut.serde.annotation.Serdeable;
+
+class PublicView {}
+class PrivateView extends PublicView {}
+@Serdeable
+@JsonInclude(JsonInclude.Include.ALWAYS)
+record Parent(@JsonUnwrapped Name name,
+              @JsonInclude(JsonInclude.Include.NON_DEFAULT) long omitted,
+              @JsonView(PublicView.class) long shown,
+              @JsonView(PrivateView.class) long secret) {}
+@Serdeable
+record Name(String value) {}
+''')
+        def name = newInstance(context, 'example.Name', 'value')
+        def parent = newInstance(context, 'example.Parent', name, 0L, 1000L, 2000L)
+
+        expect:
+        serializeToString(jsonMapper, parent, context.classLoader.loadClass('example.PublicView')) ==
+            '{"value":"value","shown":1000}'
+        serializeToString(jsonMapper, parent, context.classLoader.loadClass('example.PrivateView')) ==
+            '{"value":"value","shown":1000,"secret":2000}'
+
+        cleanup:
+        context.close()
+    }
+
+    void 'nested unwrapped getters retain their error paths'() {
+        given:
+        def context = buildContext('example.Outer', '''
+package example;
+
+import com.fasterxml.jackson.annotation.JsonUnwrapped;
+import com.fasterxml.jackson.annotation.JsonInclude;
+import io.micronaut.serde.annotation.Serdeable;
+
+@Serdeable
+@JsonInclude(JsonInclude.Include.ALWAYS)
+record Outer(@JsonUnwrapped Inner inner) {}
+@Serdeable
+@JsonInclude(JsonInclude.Include.ALWAYS)
+class Inner {
+    @JsonUnwrapped
+    public Name getName() { throw new IllegalStateException("broken getter"); }
+}
+@Serdeable
+record Name(String value) {}
+''')
+        def inner = newInstance(context, 'example.Inner', [] as Object[])
+        def outer = newInstance(context, 'example.Outer', inner)
+
+        when:
+        serializeToString(jsonMapper, outer)
+
+        then:
+        def error = thrown(SerdeException)
+        error.message.endsWith('broken getter')
+        error.pathAsString == 'example.Outer["inner"]->example.Inner["name"]'
+
+        cleanup:
+        context.close()
+    }
+
+    void 'property filters can still omit primitive siblings with always inclusion'() {
+        given:
+        def context = buildContext('example.Parent', '''
+package example;
+
+import com.fasterxml.jackson.annotation.*;
+import io.micronaut.serde.annotation.Serdeable;
+import io.micronaut.serde.PropertyFilter;
+import io.micronaut.serde.Serializer;
+import jakarta.inject.Named;
+import jakarta.inject.Singleton;
+
+@Serdeable
+@JsonFilter("hide-total")
+@JsonInclude(JsonInclude.Include.ALWAYS)
+record Parent(@JsonUnwrapped Name name, long total) {}
+@Serdeable
+record Name(String value) {}
+@Singleton
+@Named("hide-total")
+class HideTotal implements PropertyFilter {
+    public boolean shouldInclude(Serializer.EncoderContext context, Serializer<Object> serializer,
+                                 Object bean, String name, Object value) {
+        return !name.equals("total");
+    }
+}
+''')
+        def name = newInstance(context, 'example.Name', 'nested')
+        def parent = newInstance(context, 'example.Parent', name, 100000L)
+
+        expect:
+        serializeToString(jsonMapper, parent) == '{"value":"nested"}'
+
+        cleanup:
+        context.close()
+    }
+}
