+package io.micronaut.serde;
+
+import com.fasterxml.jackson.annotation.JsonUnwrapped;
+import io.micronaut.context.ApplicationContext;
+import io.micronaut.core.type.Argument;
+import io.micronaut.serde.annotation.Serdeable;
+import io.micronaut.serde.jackson.JacksonJsonMapper;
+import org.openjdk.jmh.annotations.Benchmark;
+import org.openjdk.jmh.annotations.BenchmarkMode;
+import org.openjdk.jmh.annotations.Mode;
+import org.openjdk.jmh.annotations.Scope;
+import org.openjdk.jmh.annotations.Setup;
+import org.openjdk.jmh.annotations.State;
+import org.openjdk.jmh.annotations.TearDown;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+
+/** Compares equivalent flat and unwrapped response shapes with Micronaut Serialization. */
+@State(Scope.Thread)
+@BenchmarkMode(Mode.Throughput)
+public class UnwrappedItemBenchmark {
+    private static final Argument<List<FlatItem>> FLAT = Argument.listOf(FlatItem.class);
+    private static final Argument<List<PricedItem>> UNWRAPPED = Argument.listOf(PricedItem.class);
+
+    private ApplicationContext context;
+    private JacksonJsonMapper mapper;
+    private List<FlatItem> flat;
+    private List<PricedItem> unwrapped;
+
+    @Setup
+    public void setup() throws IOException {
+        context = ApplicationContext.run(Map.of("micronaut.serde.serialization.inclusion", "ALWAYS"));
+        mapper = context.getBean(JacksonJsonMapper.class);
+        flat = new ArrayList<>(50);
+        unwrapped = new ArrayList<>(50);
+        for (int i = 0; i < 50; i++) {
+            Item item = new Item(i + 1000L, "Product " + i, "office", i + 500L, i + 200L,
+                true, List.of("sale", "featured"), new Rating(4.5, 1000));
+            long total = item.price * item.quantity;
+            flat.add(new FlatItem(item.id, item.name, item.category, item.price, item.quantity,
+                item.active, item.tags, item.rating, total));
+            unwrapped.add(new PricedItem(item, total));
+        }
+        if (!Arrays.equals(mapper.writeValueAsBytes(FLAT, flat), mapper.writeValueAsBytes(UNWRAPPED, unwrapped))) {
+            throw new IllegalStateException("Flat and unwrapped response JSON differs");
+        }
+    }
+
+    @Benchmark
+    public byte[] flat() throws IOException {
+        return mapper.writeValueAsBytes(FLAT, flat);
+    }
+
+    @Benchmark
+    public byte[] unwrapped() throws IOException {
+        return mapper.writeValueAsBytes(UNWRAPPED, unwrapped);
+    }
+
+    @TearDown
+    public void close() {
+        context.close();
+    }
+
+    @Serdeable
+    public record Rating(double score, long votes) {
+    }
+
+    @Serdeable
+    public record Item(long id, String name, String category, long price, long quantity,
+                       boolean active, List<String> tags, Rating rating) {
+    }
+
+    @Serdeable
+    public record PricedItem(@JsonUnwrapped Item item, long total) {
+    }
+
+    @Serdeable
+    public record FlatItem(long id, String name, String category, long price, long quantity,
+                           boolean active, List<String> tags, Rating rating, long total) {
+    }
+}
